{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/bath-daily.js": {
      "maxDuration": 60
    },
    "api/bath-finance.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/bath-daily",
      "schedule": "5 2 * * *"
    },
    {
      "path": "/api/ozon-paid-audit",
      "schedule": "30 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/bath-policy",
      "destination": "/api/seller-products?policy=1"
    },
    {
      "source": "/api/ozon-paid-audit",
      "destination": "/api/bath-finance?audit=paid-services"
    }
  ]
}
